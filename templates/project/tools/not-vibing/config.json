{
  "commands": {
    "precommit": [
      "npm run typecheck",
      "npm test"
    ],
    "full": [
      "npm run check"
    ],
    "typecheck": "npm run typecheck",
    "lintFile": ""
  },
  "lintExtensions": [
    ".ts",
    ".tsx",
    ".js",
    ".mjs"
  ],
  "docsPaths": [
    "docs/",
    ".claude/"
  ],
  "boundaries": [],
  "stopTimeoutSeconds": 30,
  "precommitTimeoutSeconds": 300,
  "protectedBranches": [
    "main"
  ],
  "fullTimeoutSeconds": 1800,
  "precommitWarnSeconds": 120
}
